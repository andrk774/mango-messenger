{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres"
      },
      "spec": {
        "selector": {
          "app": "mango-postgres"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 5432,
            "targetPort": "tcp"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "postgres"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "mango-postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mango-postgres"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:17-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "tcp",
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false
                },
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "mango"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "mango"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "mango-runtime",
                        "key": "MANGO_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "POSTGRES_INITDB_ARGS",
                    "value": "--encoding=UTF8 --locale=C"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "mango",
                      "-d",
                      "mango"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "mango",
                      "-d",
                      "mango"
                    ]
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ]
              }
            ]
          }
        },
        "serviceName": "postgres",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "10Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis"
      },
      "spec": {
        "selector": {
          "app": "mango-redis"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 6379,
            "targetPort": "tcp"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "redis"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "mango-redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mango-redis"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7.4-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "tcp",
                    "containerPort": 6379
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false
                },
                "args": [
                  "redis-server",
                  "--appendonly",
                  "yes",
                  "--save",
                  "60",
                  "1"
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "redis-cli",
                      "ping"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "redis-cli",
                      "ping"
                    ]
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ]
              }
            ]
          }
        },
        "serviceName": "redis",
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "mailpit"
      },
      "spec": {
        "selector": {
          "app": "mango-mailpit"
        },
        "ports": [
          {
            "name": "tcp",
            "port": 1025,
            "targetPort": "tcp"
          },
          {
            "name": "web",
            "port": 8025,
            "targetPort": "web"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "mailpit"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "mango-mailpit"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mango-mailpit"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "mailpit",
                "image": "axllent/mailpit@sha256:aef2aacc11f075ec0fb6874275ee4a421e688e11a96ebb296134d1735c7761ce",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "tcp",
                    "containerPort": 1025
                  },
                  {
                    "name": "web",
                    "containerPort": 8025
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "web"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "web"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                }
              }
            ]
          }
        }
      }
    }
  ]
}
