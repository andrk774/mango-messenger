# Вход в стек из локальной сети: HTTPS для домена MANGO_DOMAIN.
#
# Сертификат выпускает собственный удостоверяющий центр Caddy (local_certs):
# публичный ЦС не выдаст сертификат на домен, которого нет в интернете.
# Корневой сертификат этого ЦС встраивается в Android-приложение
# (scripts/export-local-ca.sh) и признаётся только для этого домена.
#
# Наружу смотрит только этот прокси. Backend, PostgreSQL, Redis и Mailpit
# по-прежнему доступны лишь с самого компьютера.
{
	local_certs
	# Корневой сертификат не ставится в хранилище контейнера — незачем.
	skip_install_trust
}

{$MANGO_DOMAIN:mango.home.arpa} {
	tls internal

	# Файлы до 100 МБ (предел вложений) плюс запас на заголовки.
	request_body {
		max_size 110MB
	}

	# WebSocket (/v1/ws) проксируется тем же правилом: Caddy сам
	# распознаёт Upgrade-запрос.
	reverse_proxy backend:8080
}
