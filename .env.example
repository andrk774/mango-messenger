# Пример файла окружения. Скопируйте в .env и задайте свои значения.
# Файл .env НЕ коммитится (см. .gitignore) и не должен попадать в образ.

# ──────────────────────────── обязательное ────────────────────────────

# Ключ подписи JWT. Не короче 32 символов.
# Сгенерировать:  openssl rand -base64 48
MANGO_JWT_SECRET=замените-на-случайную-строку-не-короче-32-символов

# ───────────────────────────── окружение ─────────────────────────────

# LOCAL | TEST | STAGING | PRODUCTION
MANGO_ENV=LOCAL

# ────────────────────────────── PostgreSQL ─────────────────────────────

POSTGRES_DB=mango
POSTGRES_USER=mango
POSTGRES_PASSWORD=mango
# Порт на хосте. 5433, а не 5432, чтобы не конфликтовать с уже
# установленным PostgreSQL или другим проектом.
POSTGRES_PORT=5433

# ──────────────────────────────── Redis ────────────────────────────────

REDIS_PORT=6380

# ──────────────────────────────── MinIO ────────────────────────────────

MINIO_USER=mangominio
MINIO_PASSWORD=mangominio123
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ─────────────────────────── почта (Mailpit) ───────────────────────────

# SMTP, куда backend отправляет письма
MAILPIT_SMTP_PORT=1026
# Веб-интерфейс: http://localhost:8026 — там видно письма подтверждения
MAILPIT_UI_PORT=8026

# ─────────────────────────────── backend ───────────────────────────────

BACKEND_PORT=8081

# Вложения (необязательно). Предел размера файла в мегабайтах; картинки
# дополнительно ограничены 20 МБ. Ключ подписи ссылок по умолчанию
# выводится из MANGO_JWT_SECRET; задайте отдельный, если секрет JWT
# может меняться независимо от ссылок.
# MANGO_STORAGE_MAX_FILE_MB=100
# MANGO_STORAGE_SIGNING_KEY=

# Push (необязательно). В Docker путь уже задан в docker-compose.yml:
# достаточно положить ключ в secrets/firebase-service-account.json.
# При локальном запуске сервера без Docker укажите путь здесь.
# MANGO_FCM_CREDENTIALS_FILE=secrets/firebase-service-account.json

# Запуск в локальной сети (README, «Запуск в локальной сети»).
# MANGO_DOMAIN=mango.home.arpa
# LAN_HTTPS_PORT=443
